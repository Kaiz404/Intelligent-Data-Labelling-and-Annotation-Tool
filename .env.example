NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only S3 multipart upload configuration. These credentials must belong
# to the AWS account that owns AWS_S3_BUCKET (or be scoped to it via a bucket
# policy). Never expose AWS credentials with NEXT_PUBLIC_.
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-s3-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Server-only per-user storage quota shown in the sidebar, in GB (binary,
# 1 GB = 1024^3 bytes). Defaults to 100 when unset or invalid. Usage is listed
# from S3 under projects/{projectId}/, which needs s3:ListBucket on
# AWS_S3_BUCKET for the projects/ prefix; without it the sidebar falls back to
# summing images.size_bytes from Supabase.
STORAGE_QUOTA_GB=100

# Server-only Roboflow config (gateway pattern: one workspace/workflow serves
# every user's project). Never expose ROBOFLOW_API_KEY with NEXT_PUBLIC_.
# The workflow runs zero-shot detection (YOLO-World); class_names are passed
# per-request from each project's label list, so no per-project Roboflow
# dataset/project is needed and no user images are retained by Roboflow.
ROBOFLOW_API_KEY=your-roboflow-workspace-api-key
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_WORKSPACE=your-roboflow-workspace-slug
ROBOFLOW_WORKFLOW_ID=gateway-zero-shot-detect
ROBOFLOW_CONFIDENCE=0.40
