NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only S3 multipart upload configuration. These credentials must belong
# to the AWS account that owns AWS_S3_BUCKET (or be scoped to it via a bucket
# policy). Never expose AWS credentials with NEXT_PUBLIC_.
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-s3-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
